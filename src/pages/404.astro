---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { getLocaleFromUrl, localizedPath, t } from "../lib/i18n";

const locale = getLocaleFromUrl(Astro.url.pathname);
const n = t(locale).notFound;
---

<Layout locale={locale} title={n.metaTitle}>
  <section class="section min-h-[60vh] flex items-center">
    <div class="container text-center">
      <p class="text-sm font-semibold tracking-widest uppercase text-theme-primary mb-4">
        404
      </p>
      <h1 class="mb-4">{n.title}</h1>
      <p class="text-lg text-theme-text-secondary mb-8">{n.body}</p>
      <Button href={localizedPath(locale, "/")} variant="primary">
        {n.button}
      </Button>
    </div>
  </section>
</Layout>
