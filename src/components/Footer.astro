---
import Icon from "./Icon.astro";
import type { Locale } from "../types/i18n";
import { brandName, localizedPath, t } from "../lib/i18n";
import site from "../data/site.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const brand = brandName(locale);
const links = dict.nav.links.map((link) => ({
  ...link,
  href: localizedPath(locale, link.href),
}));
const ctaHref = localizedPath(locale, "/contact/");
---

<footer class="bg-theme-primary-darker text-white py-10">
  <div
    class="container content flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8"
  >
    <div class="flex flex-col items-center lg:items-start w-full lg:w-1/4">
      <div class="text-2xl lg:text-3xl font-display font-bold text-white mb-2">
        {brand}
      </div>
      <p class="text-sm text-white/70 mb-4">
        {locale === "zh" ? site.brand.en : site.brand.zh}
      </p>
      <nav class="flex flex-wrap justify-center lg:justify-start gap-x-4 gap-y-2">
        {
          links.map((link) => (
            <a href={link.href} class="text-sm text-white hover:text-white/80">
              {link.label}
            </a>
          ))
        }
        <a href={ctaHref} class="text-sm text-white hover:text-white/80"
          >{dict.nav.cta}</a
        >
      </nav>
    </div>

    <div class="flex flex-col items-center lg:items-start w-full lg:w-1/3">
      <div class="flex items-start w-full my-3">
        <div class="w-8 text-center mt-1">
          <Icon name="location" size="sm" class="text-white/60 mx-auto" />
        </div>
        <p class="ml-3 text-sm">
          {site.contact.addressLine1}<br />{site.contact.addressLine2}
        </p>
      </div>
      <div class="flex items-start w-full my-3">
        <div class="w-8 text-center mt-1">
          <Icon name="phone" size="sm" class="text-white/60 mx-auto" />
        </div>
        <p class="ml-3 text-sm">{site.contact.phone}</p>
      </div>
      <div class="flex items-start w-full my-3">
        <div class="w-8 text-center mt-1">
          <Icon name="email" size="sm" class="text-white/60 mx-auto" />
        </div>
        <div class="ml-3 text-sm space-y-3">
          <div>
            <p class="text-white/70 mb-1">{dict.contact.applicationEmailsLabel}</p>
            {
              site.contact.applicationEmails.map((email) => (
                <p>
                  <a class="hover:text-white/80" href={`mailto:${email}`}>
                    {email}
                  </a>
                </p>
              ))
            }
          </div>
          <div>
            <p class="text-white/70 mb-1">{dict.contact.clientEmailsLabel}</p>
            {
              site.contact.clientEmails.map((email) => (
                <p>
                  <a class="hover:text-white/80" href={`mailto:${email}`}>
                    {email}
                  </a>
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center lg:items-start w-full lg:w-2/5">
      <h3 class="text-lg font-semibold mb-3 text-center lg:text-left font-display">
        {brand}
      </h3>
      <p
        class="text-sm text-center lg:text-left leading-relaxed max-w-md lg:max-w-none text-white/85"
      >
        {dict.footer.description}
      </p>
      <p class="text-xs text-white/55 mt-4 text-center lg:text-left leading-relaxed">
        {dict.footer.disclaimer}
      </p>
    </div>
  </div>
</footer>
