---
import { Image } from "astro:assets";
import type { Locale } from "../types/i18n";
import { t } from "../lib/i18n";
import site from "../data/site.json";
import marnLogo from "../assets/memberships/marn-badge.png";
import miaLogo from "../assets/memberships/mia.png";
import maLogo from "../assets/memberships/migration-alliance.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).memberships;

const items = [
  {
    name: "MARN",
    href: "https://www.mara.gov.au/",
    logo: marnLogo,
    alt: m.marnAlt,
    logoClass: "w-[85%] max-w-[220px] max-h-[11rem]",
    cardClass: "min-h-[220px] p-5 bg-white",
  },
  {
    name: "MIA",
    href: "https://www.mia.org.au/",
    logo: miaLogo,
    alt: m.miaAlt,
    logoClass: "w-[90%] max-w-[280px] max-h-[8rem]",
    cardClass: "min-h-[220px] p-5 bg-white",
  },
  {
    name: "Migration Alliance",
    href: "https://migrationalliance.com.au/",
    logo: maLogo,
    alt: m.maAlt,
    logoClass: "w-[80%] max-w-[200px] max-h-[9rem]",
    cardClass: "min-h-[220px] p-5 bg-white",
  },
] as const;
---

<section
  class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
  aria-labelledby="memberships-heading"
>
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-12">
      <h2
        id="memberships-heading"
        class="text-3xl lg:text-4xl font-bold text-theme-text-primary mb-4"
      >
        {m.title}
      </h2>
      <p class="text-lg text-theme-text-secondary leading-relaxed">
        {m.body}
      </p>
      <p class="mt-3 text-sm font-medium text-theme-primary">
        {m.marnLabel}: {site.marnNumber}
      </p>
    </div>

    <ul
      class="grid grid-cols-1 sm:grid-cols-3 gap-5 md:gap-6 max-w-5xl mx-auto list-none p-0 m-0"
    >
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "group flex h-full items-center justify-center rounded-xl border border-theme-border px-6 transition-all duration-300 hover:border-theme-primary/40 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-theme-primary",
                item.cardClass,
              ]}
              aria-label={item.alt}
            >
              <Image
                src={item.logo}
                alt={item.alt}
                class:list={[
                  "h-auto object-contain mx-auto transition-transform duration-300 group-hover:scale-[1.02]",
                  item.logoClass,
                ]}
                widths={[280, 400, 560]}
                sizes="(max-width: 640px) 80vw, 280px"
                loading="lazy"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
