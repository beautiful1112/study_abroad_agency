---
import Layout from "../../layouts/Layout.astro";
import Link from "../Link.astro";
import Button from "../Button.astro";
import type { Locale } from "../../types/i18n";
import { localizedPath, t } from "../../lib/i18n";
import { getArticleBySlug } from "../../data/articles";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const article = getArticleBySlug(slug);
const dict = t(locale);

if (!article) {
  return Astro.redirect(localizedPath(locale, "/articles/"));
}

const content = article[locale];
const categoryLabel =
  article.category === "process"
    ? dict.articles.categoryProcess
    : dict.articles.categoryIntro;
const title = `${content.title} | ${locale === "zh" ? "趣袋鼠" : "Rooute"}`;
---

<Layout locale={locale} title={title} description={content.description}>
  <section class="section bg-theme-surface-muted">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <Link href={localizedPath(locale, "/articles/")}>
          ← {dict.articles.backToList}
        </Link>
        <div class="flex flex-wrap items-center gap-3 mt-6 mb-4 text-sm">
          <span class="font-semibold text-theme-primary">{categoryLabel}</span>
          <span class="text-theme-text-muted">{article.date}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{content.title}</h1>
        <p class="text-lg text-theme-text-secondary mb-10">
          {content.description}
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-theme-surface pt-0">
    <div class="container">
      <article
        class="prose prose-lg max-w-3xl mx-auto article-body text-theme-text-secondary"
        set:html={content.html}
      />
      <p
        class="max-w-3xl mx-auto mt-10 text-sm text-theme-text-muted leading-relaxed border-t border-theme-border pt-6"
      >
        {dict.articles.disclaimer}
      </p>
      <div class="max-w-3xl mx-auto mt-10 flex flex-wrap gap-4">
        <Button href={localizedPath(locale, "/contact/")} variant="primary">
          {dict.nav.cta}
        </Button>
        <Button href={localizedPath(locale, "/articles/")} variant="white">
          {dict.articles.backToList}
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .article-body :global(h2) {
    color: var(--color-theme-text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .article-body :global(h3) {
    color: var(--color-theme-text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .article-body :global(p),
  .article-body :global(li) {
    line-height: 1.75;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 1rem 0 1.25rem;
    padding-left: 1.25rem;
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--color-theme-border);
    padding: 0.65rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .article-body :global(th) {
    background: var(--color-theme-surface-muted);
    color: var(--color-theme-text-primary);
    font-weight: 600;
  }
</style>
