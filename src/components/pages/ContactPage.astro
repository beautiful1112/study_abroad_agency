---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import { Image } from "astro:assets";
import type { Locale } from "../../types/i18n";
import { t } from "../../lib/i18n";
import site from "../../data/site.json";
import contactImage from "../../assets/contact-image.jpg";
import wechatQr from "../../assets/wechat-qr.jpg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).contact;
const hoursWeekday =
  locale === "zh" ? site.contact.hoursWeekday.zh : site.contact.hoursWeekday.en;
const hoursSaturday =
  locale === "zh"
    ? site.contact.hoursSaturday.zh
    : site.contact.hoursSaturday.en;
const hoursSunday =
  locale === "zh" ? site.contact.hoursSunday.zh : site.contact.hoursSunday.en;
---

<Layout locale={locale} title={c.metaTitle} description={c.metaDescription}>
  <PageHero
    title={c.heroTitle}
    description={c.heroDescription}
    image={contactImage}
  />

  <section
    class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
    id="contact"
  >
    <div class="container">
      <div class="flex items-stretch justify-center">
        <div class="grid md:grid-cols-2 gap-8 w-full max-w-6xl">
          <div class="h-full mt-3 mb-4 md:pr-6">
            <p class="mt-3 mb-12 text-lg text-theme-text-primary">{c.intro}</p>
            <ul class="mb-6 md:mb-0 space-y-2">
              <li class="flex">
                <div class="flex h-10 w-10 items-center justify-center">
                  <svg
                    class="w-6 h-6 text-theme-primary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                    ></path>
                    <path
                      d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4 mb-4">
                  <h3
                    class="mb-2 text-lg font-medium leading-6 text-theme-text-primary"
                  >
                    {c.contactLabel}
                  </h3>
                  <p class="text-theme-text-primary">
                    {c.phonePrefix}{site.contact.phone}
                  </p>
                  <div class="mt-4 space-y-3">
                    <div>
                      <p class="text-sm font-semibold text-theme-primary mb-1">
                        {c.applicationEmailsLabel}
                      </p>
                      {
                        site.contact.applicationEmails.map((email) => (
                          <p class="text-theme-text-primary">
                            <a
                              class="hover:text-theme-primary underline-offset-2 hover:underline"
                              href={`mailto:${email}`}
                            >
                              {email}
                            </a>
                          </p>
                        ))
                      }
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-theme-primary mb-1">
                        {c.clientEmailsLabel}
                      </p>
                      {
                        site.contact.clientEmails.map((email) => (
                          <p class="text-theme-text-primary">
                            <a
                              class="hover:text-theme-primary underline-offset-2 hover:underline"
                              href={`mailto:${email}`}
                            >
                              {email}
                            </a>
                          </p>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </li>
              <li class="flex">
                <div class="flex h-10 w-10 items-center justify-center">
                  <svg
                    class="w-6 h-6 text-theme-primary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="ml-4 mb-4">
                  <h3
                    class="mb-2 text-lg font-medium leading-6 text-theme-text-primary"
                  >
                    {c.hoursLabel}
                  </h3>
                  <p class="text-theme-text-primary">{hoursWeekday}</p>
                  <p class="text-theme-text-primary">{hoursSaturday}</p>
                  <p class="text-theme-text-primary">{hoursSunday}</p>
                </div>
              </li>
            </ul>
          </div>

          <div
            class="bg-white rounded-2xl shadow-xl p-6 md:p-8 h-full border border-theme-border hover:shadow-2xl transition-shadow duration-300 flex flex-col items-center justify-center text-center"
            id="form"
          >
            <h2 class="mb-2 text-2xl font-bold text-theme-text-primary">
              {c.formTitle}
            </h2>
            <p class="mb-6 text-sm text-theme-text-secondary max-w-sm">
              {c.formQrHint}
            </p>
            <div
              class="rounded-xl border border-theme-border-medium bg-white p-4 shadow-sm"
            >
              <Image
                src={wechatQr}
                alt={c.formQrAlt}
                class="w-64 max-w-full h-auto mx-auto"
                widths={[256, 320, 400]}
                sizes="256px"
                loading="lazy"
              />
            </div>
            <p class="mt-5 text-sm text-theme-text-muted max-w-xs">
              {c.formQrCaption}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
